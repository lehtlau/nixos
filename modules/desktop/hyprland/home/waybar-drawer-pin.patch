 bool Group::handleToggle(GdkEventButton* const& e) {
+  // Right click pins a hover drawer open, and unpins it, so its contents can
+  // be read without keeping the pointer on the group.
+  if (is_drawer && !click_to_reveal && e->button == 3) {
+    pinned = !pinned;
+    if (pinned) {
+      show_group();
+      box.get_style_context()->add_class("pinned");
+    } else {
+      box.get_style_context()->remove_class("pinned");
+      hide_group();
+    }
+    return true;
+  }
   if (!click_to_reveal || e->button != 1) {
     return false;
   }
